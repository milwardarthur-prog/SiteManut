generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider  = "postgresql"
    url       = env("DATABASE_URL")
    directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  TECHNICIAN
}

enum MaintenanceType {
  PREVENTIVA
  CORRETIVA
  RETRABALHO
}

enum WorkOrderStatus {
  PENDENTE_APROVACAO
  APROVADA
  EM_EXECUCAO
  AGUARDANDO_ENCERRAMENTO
  FINALIZADA
  REJEITADA
}

enum OSScope {
  NORMAL
  CHECKLIST
  TESTE_CARGA
  REVISAO
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  role           UserRole @default(TECHNICIAN)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignedOrders WorkOrder[]       @relation("TechnicianOrders")
  createdOrders  WorkOrder[]       @relation("CreatorOrders")
  closedOrders   WorkOrder[]       @relation("CloserOrders")
  helperRecords  WorkOrderHelper[]
  authoredComments WorkOrderComment[] @relation("CommentAuthor")
}

model Equipment {
  id             String   @id @default(cuid())
  equipmentNumber String  @unique
  name           String
  description    String?
  model          String?
  year           Int?
  currentHorimeter Float  @default(0)
  location       String?
  serialNumber   String?
  qrCodeData     String   @unique

  // Filtros
  airFilter1     String?
  airFilter2     String?
  fuelFilter1    String?
  fuelFilter2    String?
  fuelFilter3    String?
  fuelFilter4    String?
  lubeFilter1    String?
  lubeFilter2    String?
  lubeFilter3    String?
  lubeFilter4    String?
  waterFilter    String?

  // Componentes
  controller     String?
  tank           String?
  crankcase      String?
  battery        String?
  belt1          String?
  belt2          String?
  belt3          String?
  belt4          String?

  // Dimensões
  height         String?
  width          String?
  depth          String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  files          EquipmentFile[]
  workOrders     WorkOrder[]

  @@index([equipmentNumber])
}

model EquipmentFile {
  id               String   @id @default(cuid())
  fileName         String
  cloudStoragePath String
  contentType      String   @default("application/pdf")
  isPublic         Boolean  @default(false)
  fileSize         Int?     
  equipmentId      String
  equipment        Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([equipmentId])
}

model WorkOrder {
  id              String          @id @default(cuid())
  orderNumber     Int             @unique @default(autoincrement())
  status          WorkOrderStatus @default(PENDENTE_APROVACAO)
  maintenanceType MaintenanceType
  scope           OSScope         @default(NORMAL)
  horimeter       Float?          
  comments        String?         
  adminNotes      String?         
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  startedAt       DateTime?       
  techClosedAt    DateTime?       
  closedAt        DateTime?       
  totalTimeMinutes Int?           
  deletedAt       DateTime?       

  // Campos específicos de CHECKLIST
  checklistDate    DateTime?
  tankSample       String?
  checkFuelFilter1 String?
  checkFuelFilter2 String?
  checkFuelFilter3 String?

  // Campos específicos de TESTE DE CARGA
  loadTestDate     DateTime?
  voltageEmpty     String?
  frequencyEmpty   String?
  load             String?
  frequencyLoad    String?

  // Campos específicos de REVISÃO (troca de óleo e filtros)
  revisionDate     DateTime?
  oilLiters        String?
  revisionFilters  String?   // JSON: { "fuelFilter1": "TROCADO" | "NAO", ... }

  technicianId    String?
  technician      User?           @relation("TechnicianOrders", fields: [technicianId], references: [id])
  createdById     String
  createdBy       User            @relation("CreatorOrders", fields: [createdById], references: [id])
  closedById      String?
  closedBy        User?           @relation("CloserOrders", fields: [closedById], references: [id])
  equipmentId     String
  equipment       Equipment       @relation(fields: [equipmentId], references: [id])

  parts           WorkOrderPart[]
  helpers         WorkOrderHelper[]
  photos          WorkOrderPhoto[]
  technicalComments WorkOrderComment[]

  @@index([status])
  @@index([technicianId])
  @@index([equipmentId])
  @@index([createdAt])
  @@index([scope])
  @@index([deletedAt])
}

model WorkOrderComment {
  id          String    @id @default(cuid())
  content     String
  createdAt   DateTime  @default(now())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation("CommentAuthor", fields: [authorId], references: [id])

  @@index([workOrderId])
  @@index([authorId])
}

model WorkOrderPart {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

model WorkOrderHelper {
  id          String    @id @default(cuid())
  startTime   DateTime
  endTime     DateTime?
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  helperId    String
  helper      User      @relation(fields: [helperId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
  @@index([helperId])
}

model WorkOrderPhoto {
  id               String    @id @default(cuid())
  fileName         String
  cloudStoragePath String
  contentType      String    @default("image/jpeg")
  isPublic         Boolean   @default(false)
  workOrderId      String
  workOrder        WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())

  @@index([workOrderId])
}

model DataStore {
  id        String   @id @default(cuid())
  key       String   @unique
  content   String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
